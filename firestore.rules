rules_version = '2';

// Pe scurt:
// - În aplicație intră doar adresele din colecția `allowed` (puse acolo la invitare) și adminii (`admins`).
// - O listă o văd doar membrii ei. Orice membru poate invita; scoate oameni doar creatorul listei sau adminul.
//   Oricine poate ieși singur dintr-o listă (în afară de creator, care o poate șterge).
// - Adminul vede toate listele (doar nume, membri, număr de produse), nu și conținutul lor (produse,
//   mesaje, poze), decât în listele în care e membru. O listă străină o șterge prin funcția `adminDeleteList`.
// - `userPrefs/{uid}`: setările de aspect ale fiecăruia (temă, font etc.), doar pentru el.
// - `announced/{uid}`: ce a anunțat deja fiecare, pe fiecare listă (pentru „Gata, anunță”), doar pentru el.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(myEmail()));
    }
    function isAllowed() {
      return signedIn()
        && (exists(/databases/$(database)/documents/allowed/$(myEmail())) || isAdmin());
    }
    function isMember(list) {
      return isAllowed() && myEmail() in list.memberEmails;
    }
    function isOwner(list) {
      return signedIn() && list.ownerUid == request.auth.uid;
    }

    // Adminii se adaugă manual din consolă: colecția `admins`, ID-ul documentului = adresa de email.
    match /admins/{email} {
      allow read: if signedIn() && email == myEmail();
    }

    match /allowed/{email} {
      allow read: if signedIn() && (email == myEmail() || isAdmin());
      allow create, update: if isAllowed()
        && request.resource.data.keys().hasOnly(['email', 'invitedByEmail', 'at'])
        && request.resource.data.email == email
        && request.resource.data.invitedByEmail == myEmail();
      allow delete: if isAdmin();
    }

    // Telefoanele care primesc notificări. ID-ul documentului = codul FCM al telefonului.
    // Le citește doar funcția `announce` (din cloud); aplicația doar își scrie și își șterge propriul cod.
    match /pushTokens/{token} {
      allow create, update: if isAllowed()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'at', 'ua'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == myEmail();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // `announceLog` (limita de anunțuri) e folosit doar de funcție; aplicația nu are acces.

    match /userPrefs/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['prefs', 'at'])
        && request.resource.data.prefs is map
        && request.resource.data.prefs.size() <= 20;
    }

    match /announced/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lists', 'at'])
        && request.resource.data.lists is map
        && request.resource.data.lists.size() <= 100;
    }

    match /lists/{listId} {
      function list() {
        return get(/databases/$(database)/documents/lists/$(listId)).data;
      }
      function validList(l) {
        return l.keys().hasOnly(['name', 'ownerUid', 'ownerEmail', 'memberEmails', 'itemCount', 'createdAt', 'aisles'])
          && (!('aisles' in l) || (l.aisles is list && l.aisles.size() <= 40))
          && l.name is string && l.name.size() > 0 && l.name.size() <= 60
          && l.memberEmails is list && l.memberEmails.size() <= 30
          && l.ownerEmail in l.memberEmails;
      }
      function membersOk(before, after) {
        return after.memberEmails == before.memberEmails
          || isOwner(before) || isAdmin()
          || after.memberEmails.hasAll(before.memberEmails)                    // doar adăugări (invitații)
          || after.memberEmails == before.memberEmails.removeAll([myEmail()]); // ieși singur din listă
      }

      allow read: if isMember(resource.data) || isAdmin();

      allow create: if isAllowed()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == myEmail()
        && validList(request.resource.data);

      allow update: if (isMember(resource.data) || isAdmin())
        && validList(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && membersOk(resource.data, request.resource.data);

      allow delete: if isOwner(resource.data) || isAdmin();

      // Catalogul de produse folosite (sugestii și raionul ținut minte).
      match /products/{key} {
        allow read, write: if isMember(list());
      }

      match /items/{itemId} {
        function validItem(i) {
          return i.name is string && i.name.size() > 0 && i.name.size() <= 120
            && i.status in ['pending', 'bought', 'skipped']
            && i.archived is bool;
        }

        allow read, delete: if isMember(list());
        allow create: if isMember(list())
          && validItem(request.resource.data)
          && request.resource.data.addedBy.uid == request.auth.uid;
        allow update: if isMember(list())
          && validItem(request.resource.data)
          && request.resource.data.addedBy == resource.data.addedBy;

        match /messages/{msgId} {
          allow read, delete: if isMember(list());
          allow create: if isMember(list())
            && request.resource.data.keys().hasOnly(['text', 'photo', 'by', 'at', 'reactions'])
            && request.resource.data.by.uid == request.auth.uid
            && request.resource.data.text is string && request.resource.data.text.size() <= 1000
            && (request.resource.data.photo == null
                || (request.resource.data.photo is string && request.resource.data.photo.size() < 900000));
          // Reacțiile: oricine din listă le poate modifica. În rest, se poate doar șterge poza
          // (la „Golește rezolvatele”, pentru produsele arhivate); textul rămâne neatins.
          allow update: if isMember(list())
            && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
                || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo', 'photoDeleted'])
                    && request.resource.data.photo == null && request.resource.data.photoDeleted == true));
        }
      }
    }
  }
}
