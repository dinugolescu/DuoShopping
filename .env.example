# Copiază fișierul ca .env.local și completează valorile din Firebase Console
# (Project settings → General → Your apps → Web app → SDK setup and configuration).
VITE_FIREBASE_API_KEY=
# Pe Firebase Hosting pune aici domeniul pe care rulează aplicația (ex. numele-proiectului.web.app),
# nu ...firebaseapp.com. Așa merge login-ul și din aplicația instalată pe iPhone. Detalii în SETUP.md.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
